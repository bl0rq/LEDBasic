{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LEDBasic TUI",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '${workspaceFolder}\\tools\\run-tui.ps1'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build host tools",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "LEDBasic TUI (open file)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '${workspaceFolder}\\tools\\run-tui.ps1' '${file}'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build host tools",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "LEDBasic TUI (VS Code terminal)",
      "type": "node-terminal",
      "request": "launch",
      "command": "'${workspaceFolder}\\tools\\build\\tui\\ledbasic-tui.exe'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build host tools",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug LEDBasic TUI (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/tools/build/tui/ledbasic-tui",
      "windows": {
        "program": "${workspaceFolder}/tools/build/tui/ledbasic-tui.exe",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "environment": [
          {
            "name": "PATH",
            "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
          }
        ]
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "preLaunchTask": "Build host tools",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
